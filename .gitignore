# =========================================================
# MedWaste AI - Comprehensive Git Ignore Rules
# =========================================================

# 1. Python Virtual Environment
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# 2. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# 3. SQLite Database Files
*.sqlite3
*.sqlite
*.db
*.db-journal
*.db-wal
*.db-shm
backend/medwaste.db

# 4. Uploaded Files & Temporary Media
backend/.uploads/*
!backend/.uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# 5. Environment Variables & Secret Credentials
.env
.env.*
!.env.example

# 6. IDEs & Code Editor Settings
.idea/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json

# 7. Operating System Cache & Thumbnails
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

# 8. Logs & Temporary Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
